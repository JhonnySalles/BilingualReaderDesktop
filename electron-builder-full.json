{
  "appId": "com.bilingualreader.desktop",
  "productName": "Bilingual Reader",
  "directories": {
    "output": "exec"
  },
  "win": {
    "icon": "app/assets/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "shortcutName": "Bilingual Reader",
    "artifactName": "BilingualReader-Setup-AI-${version}.${ext}",
    "include": "scripts/installer.nsh",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "BilingualReader-Portable-AI-${version}.${ext}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "app/assets/**/*",
    "native/libmobi-addon/build/Release/*.node",
    "native/libmobi-addon/index.js",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/kuromoji/dict/**",
    "**/node_modules/7zip-bin/**",
    "**/*.node",
    "native/libmobi-addon/**/*.node"
  ],
  "extraResources": [
    {
      "from": ".env.production",
      "to": ".env.production"
    },
    {
      "from": "app/assets/tessdata",
      "to": "tessdata"
    },
    {
      "from": "public/assets/system_small.dic",
      "to": "sudachi/system_small.dic"
    },
    {
      "from": "public/assets/fonts",
      "to": "fonts"
    },
    {
      "from": "public/assets/kanji.sql",
      "to": "assets/kanji.sql"
    },
    {
      "from": "public/assets/kanjax.sql",
      "to": "assets/kanjax.sql"
    },
    {
      "from": "public/assets/vocabulary.sql",
      "to": "assets/vocabulary.sql"
    },
    {
      "from": "public/assets/llm",
      "to": "assets/llm",
      "filter": [
        "llama-server.exe",
        "*.dll",
        "*.md",
        "Qwen2.5-1.5B-Instruct-Q4_K_M.gguf"
      ]
    },
    {
      "from": "node_modules/7zip-bin",
      "to": "7zip-bin",
      "filter": [
        "**/*"
      ]
    }
  ]
}
