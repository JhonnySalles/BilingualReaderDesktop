{
  "name": "bilingual-reader-desktop",
  "version": "1.0.0",
  "main": "dist-electron/app/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "fetch:libmobi": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-libmobi.ps1",
    "build:native": "node ./scripts/build-libmobi-addon.js",
    "test:epub-packer": "yarn compile:electron && node dist-electron/app/services/ebook-convert/epub-packer.spec.js",
    "test:ebook-convert-smoke": "yarn compile:electron && node dist-electron/app/services/ebook-convert/smoke.spec.js && node dist-electron/app/services/ebook-convert/smoke-calibre.spec.js",
    "generate:icons": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-icons.ps1",
    "copy:jp-assets": "powershell -ExecutionPolicy Bypass -File ./scripts/copy-japanese-assets.ps1",
    "electron:dev": "concurrently \"ng serve\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:4200 && electron .\"",
    "build:electron": "yarn compile:electron && yarn build:native && yarn build && electron-builder",
    "release:win": "scripts\\build-release.bat"
  },
  "build": {
    "appId": "com.bilingualreader.desktop",
    "productName": "Bilingual Reader",
    "directories": {
      "output": "exec"
    },
    "win": {
      "icon": "app/assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bilingual Reader",
      "artifactName": "BilingualReader-Setup-${version}.${ext}",
      "include": "scripts/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "BilingualReader-Portable-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "app/assets/**/*",
      "public/**/*",
      "native/libmobi-addon/build/Release/*.node",
      "native/libmobi-addon/index.js",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/kuromoji/dict/**",
      "**/node_modules/7zip-bin/**",
      "**/*.node",
      "native/libmobi-addon/**/*.node"
    ],
    "extraResources": [
      {
        "from": ".env.production",
        "to": ".env.production"
      },
      {
        "from": "app/assets/tessdata",
        "to": "tessdata"
      },
      {
        "from": "public/assets/system_small.dic",
        "to": "sudachi/system_small.dic"
      },
      {
        "from": "public/assets/fonts",
        "to": "fonts"
      },
      {
        "from": "node_modules/7zip-bin",
        "to": "7zip-bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "private": true,
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@sentry/electron": "7.18.0",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "epubjs": "^0.3.93",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "kuromoji": "^0.1.2",
    "mammoth": "1.9.1",
    "msedge-tts": "^2.0.7",
    "node-unrar-js": "^2.0.2",
    "rxjs": "~7.8.0",
    "sudachi-ts": "^0.1.0",
    "tar": "^7.5.22",
    "tesseract.js": "^5.1.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jasmine": "~5.1.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.4.0",
    "@types/tar": "^7.0.87",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "wait-on": "^9.1.0"
  }
}
