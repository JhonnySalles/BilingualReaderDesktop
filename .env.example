# Copy to .env at the repository root (never commit .env).
# Dev uses .env; packaged builds prefer .env.production (see electron-builder extraResources).
# Use the same GCP/Firebase project as the Android app so Drive/Firestore data is shared.

# Web client ID (Firebase / Sign-In) — type 3 from google-services.json
GOOGLE_ID_TOKEN=xxxxx.apps.googleusercontent.com

# OAuth Desktop client (Google Cloud Console → Credentials → Desktop app)
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxx

# Firebase Web app config (same project as Android)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=bilingual-reader-272ac.firebaseapp.com
FIREBASE_PROJECT_ID=bilingual-reader-272ac
FIREBASE_APP_ID=1:...:web:...

# Optional
# ANIME_LIST_CLIENT_ID=
# OPENROUTER_API_KEY=

# --- Telemetry / Sentry (desktop-only project — do NOT reuse the Android Sentry DSN) ---
# Manual setup: create Sentry project "bilingual-reader-desktop" (Electron/Node) in your org,
# then paste the DSN below. Crashlytics is not used on desktop.
#
# Debug (.env): keep TELEMETRY_ENABLED=false so local runs do not spam Sentry or the console.
# To validate reporting locally: set TELEMETRY_ENABLED=true and fill SENTRY_DSN.
SENTRY_DSN=
TELEMETRY_ENABLED=false
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
