    "sections": {
      "library": {
        "title": "Library",
        "p1": "Use the sidebar to switch between Home, manga, books, and custom libraries.",
        "p2": "Configure default folders and extra libraries in Settings. Default sort order can also be set there.",
        "p3": "Library search supports filters with @ (e.g. @author Name)."
      },
      "mangaReader": {
        "title": "Manga Reader",
        "p1": "Open a manga by clicking its cover or via the details screen. Adjust reading direction (including two-page spreads), zoom, and turn animations.",
        "p2": "Tap/click on the 3×3 zones as configured. Shift+drag activates the magnifier.",
        "p3": "Buttons and touch zones can navigate to previous/next files in the folder."
      },
      "bookReader": {
        "title": "Book Reader",
        "p1": "EPUB and converted formats open in the text reader with typography options, TOC, search, and colored highlights.",
        "p2": "TTS (text-to-speech) and furigana can be enabled in book settings.",
        "p3": "Text selection offers copying; search/translate on selection will be available in future updates."
      },
      "subtitlesOcr": {
        "title": "Subtitles & OCR",
        "p1": "In the manga reader, open the subtitle panel to import JSON and draw bounding boxes.",
        "p2": "OCR recognizes regions or entire pages (Tesseract / Windows). OCR translation uses the AI tab when enabled."
      },
      "vocabulary": {
        "title": "Vocabulary",
        "p1": "The Vocabulary screen lists words extracted from manga or books, with favorites and filters.",
        "p2": "Enable automatic extraction in manga/book settings to import while reading."
      },
      "statistics": {
        "title": "Statistics & History",
        "p1": "Statistics aggregate reading time and pages from your reading history.",
        "p2": "In Settings → System you can clear statistics history without deleting file bookmarks."
      },
      "sharemark": {
        "title": "ShareMark",
        "p1": "Sync progress, favorites, and annotations with Google Drive or Firestore (same collections as Android).",
        "p2": "OAuth credentials must be configured in the project's .env file."
      },
      "touch": {
        "title": "Touch Zones",
        "p1": "In Settings, open “Configure click functions” to map the 3×3 grid for manga or book readers."
      },
      "settings": {
        "title": "Settings & Maintenance",
        "p1": "Backup/restore SQLite, clear cover cache, and adjust theme, glassmorphism, and 3D covers.",
        "p2": "The AI tab stores the OpenRouter API key and models used for OCR translation."
      }
    }
  },
